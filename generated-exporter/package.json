{
  "name": "supernova-dtcg-exporter",
  "version": "0.1.0",
  "description": "Exports Supernova design tokens as W3C DTCG (Design Tokens Format Module) JSON, targeting the subset Style Dictionary v4/v5 can digest today.",
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supernovaio/sdk-exporters": "latest",
    "@supernovaio/export-utils": "latest",
    "@supernovaio/export-helpers": "latest"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "ts-loader": "^9.5.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
